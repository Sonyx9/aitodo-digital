---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="AI Školení pro Firmy | Workshopy a Konzultace" description="Školíme AI tak, aby zítra šetřila čas. Praktické workshopy pro firmy, školení týmů a konzultace na míru.">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-gray-900 focus:text-white focus:rounded-lg">
    Přeskočit na hlavní obsah
  </a>
  <Header />
  
  <main id="main-content" class="pt-16">
    <!-- WRAPPER: hero + claim sdílejí jedno pozadí → žádný předěl -->
    <div 
      class="relative -mt-[100px] bg-gray-100"
      style={`background-image: url(${import.meta.env.BASE_URL}hero-image.jpg); background-size: cover; background-position: top center;`}
    >
      <!-- Overlay nahoře: bílá → průhledná (čitelnost textu) -->
      <div class="absolute inset-0 bg-gradient-to-b from-white/75 via-white/30 to-transparent pointer-events-none z-0" aria-hidden="true" />
      <!-- Overlay dole: průhledná → gray-50 (napojení na sluzby sekci) -->
      <div class="absolute bottom-0 left-0 right-0 h-56 pointer-events-none z-0" style="background: linear-gradient(to bottom, transparent, rgb(249,250,251));" aria-hidden="true" />

      <!-- Hero Section -->
      <section class="relative pt-20 md:pt-24 pb-8 sm:pb-10 md:pb-12 overflow-x-hidden">
        <!-- Text a tlačítka -->
        <div class="container mx-auto max-w-5xl px-6 text-center relative z-10 mt-[50px]">
          <!-- Eyebrow -->
          <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-8 animate-fade-in">
            AI školení pro firmy
          </p>
          
          <!-- H1 -->
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-10 leading-[1.1] animate-fade-in-delay">
            Školíme AI tak, aby <span class="font-serif italic text-primary-500">zítra</span> šetřila čas.
          </h1>
          
          <!-- Subtitle -->
          <p class="text-xl md:text-2xl text-gray-600 mb-12 max-w-3xl mx-auto leading-relaxed animate-fade-in-delay-2">
            Praktické workshopy, bezpečné školení týmů a konzultace na míru. 
            Naučíme vás používat AI efektivně v každodenní práci.
          </p>
          
          <!-- CTAs – dvě tlačítka -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-delay-3">
            <a 
              href="/firemni-skoleni"
              class="px-8 py-3.5 rounded-full bg-white border-2 border-gray-300 text-gray-900 font-semibold hover:border-gray-400 transition-all focus:outline-none focus:ring-2 focus:ring-gray-300 focus:ring-offset-2 inline-flex items-center gap-2 shadow-lg"
            >
              Firemní školení
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a 
              href="#témata"
              class="px-8 py-3.5 rounded-full bg-white border-2 border-gray-300 text-gray-900 font-semibold hover:border-gray-400 transition-all focus:outline-none focus:ring-2 focus:ring-gray-300 focus:ring-offset-2 shadow-lg"
            >
              Pro jednotlivce
            </a>
          </div>
        </div>
        
        <!-- Video -->
        <div class="mt-4 sm:mt-6 md:mt-8 w-full overflow-x-hidden relative z-10">
          <div class="container mx-auto max-w-4xl px-4 sm:px-6">
            <div class="relative w-full aspect-video rounded-xl overflow-hidden shadow-2xl ring-2 ring-white/30">
              <iframe
                src="https://www.youtube.com/embed/hF-UgYTRVqg?si=cnku3vvHKV2Tmyxh"
                title="YouTube video player"
                class="absolute inset-0 w-full h-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Claim Section – průhledná, sdílí pozadí s hero -->
      <section id="skoleni" class="relative py-20 md:py-28 px-6 z-10">
        <div class="container mx-auto max-w-6xl">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <div>
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-8">
                Praktické AI dovednosti pro <span class="font-serif italic text-primary-500">reálnou</span> práci.
              </h2>
            </div>
            <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
              <p>
                Naše školení jsou určena pro týmy, které chtějí začít používat AI efektivně a bezpečně. 
                Zaměřujeme se na praktické dovednosti, které můžete aplikovat okamžitě.
              </p>
              <p>
                Školení probíhá interaktivně, s důrazem na hands-on cvičení a reálné příklady z vašeho 
                oboru. Každý workshop je přizpůsoben potřebám vašeho týmu.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- 3 Pilíře / Benefity -->
    <section id="sluzby" class="py-32 px-6 bg-gray-50 relative">
      <!-- Gradient overlay pro plynulý přechod z předchozí sekce -->
      <div class="absolute top-0 left-0 right-0 h-40 pointer-events-none" style="background: linear-gradient(to bottom, rgba(255,255,255,0.6) 0%, rgba(249,250,251,0.8) 50%, rgba(249,250,251,1) 100%);"></div>
      <div class="container mx-auto max-w-6xl relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <!-- Pilíř 1 -->
          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Školení na míru týmům</h3>
            <p class="text-gray-600 leading-relaxed">
              Každé školení přizpůsobujeme konkrétním potřebám vašeho týmu a oboru. 
              Zaměřujeme se na praktické aplikace, které vám skutečně pomohou.
            </p>
          </div>
          
          <!-- Pilíř 2 -->
          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Bezpečnost a firemní data</h3>
            <p class="text-gray-600 leading-relaxed">
              Důraz klademe na bezpečnost a ochranu vašich dat. Naučíme vás používat AI nástroje 
              tak, aby vaše firemní informace zůstaly v bezpečí.
            </p>
          </div>
          
          <!-- Pilíř 3 -->
          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Okamžitá použitelnost</h3>
            <p class="text-gray-600 leading-relaxed">
              Hands-on přístup znamená, že se učíte praxí. Po skončení školení budete schopni 
              okamžitě aplikovat nové dovednosti v každodenní práci.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Gradient Banner - duhový gradient full-width od okraje k okraji -->
    <div class="w-full overflow-x-hidden">
      <section class="py-40 relative" style="margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); width: 100vw;">
        <!-- Duhový gradient: peach → pink → purple → white (jako na fotce) -->
        <!-- Horizontální gradient zleva doprava s více barevnými zastávkami pro plynulý přechod -->
        <div 
          class="absolute inset-0 w-full h-full"
          style="background: linear-gradient(to right, #ffb3a7 0%, #ffa8b5 5%, #ff9ec8 12%, #ff9dd0 18%, #f5a3d3 25%, #f0abfc 32%, #e4b3fc 40%, #d8b4fe 48%, #d1b8fe 55%, #c9bdfe 62%, #ddd6fe 70%, #e9d5ff 78%, #f3e8ff 85%, #faf5ff 92%, #fef7ff 96%, white 100%);"
        ></div>
        
        <div class="container mx-auto max-w-6xl px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <!-- Eyebrow podle reference -->
            <p class="text-sm font-medium text-gray-800/90 uppercase tracking-wider mb-4">
              Bez chaosu. Jen výsledky.
            </p>
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-10 leading-tight">
              Chcete, aby Vám AI pomáhala <span class="font-serif italic text-gray-700">do 14 dnů</span>?
            </h2>
            <a 
              href="#kontakt"
              class="inline-block px-8 py-4 rounded-full bg-white border-2 border-gray-300 text-gray-900 font-semibold hover:border-gray-400 transition-all transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:ring-offset-2 shadow-lg"
            >
              Přidejte se
            </a>
          </div>
          <div class="hidden lg:block">
            <!-- Placeholder pro doplňkový vizuál s glow efektem -->
            <div class="aspect-square rounded-3xl bg-white/30 backdrop-blur-md flex items-center justify-center relative overflow-hidden border border-white/20">
              <!-- Glow efekt -->
              <div class="absolute inset-0 bg-gradient-to-br from-white/30 to-transparent"></div>
              <svg class="w-40 h-40 text-gray-700/50 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
          </div>
        </div>
        </div>
      </section>
    </div>

    <!-- Reference – vylepšená grafika -->
    <section id="reference" class="py-24 px-6 bg-gray-50/80 relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-32 pointer-events-none" style="background: linear-gradient(to bottom, rgba(255,255,255,0.5) 0%, rgba(249,250,251,0.98) 100%);"></div>
      <div class="container mx-auto max-w-6xl relative z-10">
        <div class="text-left mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Napsali o školení</h2>
          <div class="w-14 h-1 rounded-full mt-3 ref-accent-bar"></div>
        </div>

        <!-- Rotující reference – dva hlavní bloky vedle sebe (stejný styl jako malé karty) -->
        <div class="mb-14 relative pl-2">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <article id="hero-ref-box-1" class="group rounded-2xl p-6 shadow-md min-h-[180px] transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 ref-small-card relative">
              <p id="hero-ref-quote-1" class="text-gray-800 text-xl md:text-2xl leading-relaxed font-medium mb-5 text-left transition-all duration-500">„Během 16 hodin se podařilo změnit můj mindset týkající se AI.“</p>
              <div class="h-1 w-10 rounded-full mb-3 ref-small-card-line" style="background-color: #F05D4A;"></div>
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p id="hero-ref-company-1" class="font-semibold text-gray-900 transition-opacity duration-300">FESTOOL</p>
                  <p id="hero-ref-desc-1" class="text-sm text-gray-500 mt-0.5 transition-opacity duration-300">Výroba nářadí</p>
                </div>
                <div class="h-8 flex items-center justify-center bg-gray-100 rounded border border-gray-200 shrink-0 text-gray-400 text-xs px-3 min-w-[5rem]">Logo</div>
              </div>
            </article>
            <article id="hero-ref-box-2" class="group rounded-2xl p-6 shadow-md min-h-[180px] transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 ref-small-card relative">
              <p id="hero-ref-quote-2" class="text-gray-800 text-xl md:text-2xl leading-relaxed font-medium mb-5 text-left transition-all duration-500">„Radek je boží. :)“</p>
              <div class="h-1 w-10 rounded-full mb-3 ref-small-card-line" style="background-color: #F05D4A;"></div>
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p id="hero-ref-company-2" class="font-semibold text-gray-900 transition-opacity duration-300">BARENTZ</p>
                  <p id="hero-ref-desc-2" class="text-sm text-gray-500 mt-0.5 transition-opacity duration-300">Distribuce surovin</p>
                </div>
                <div class="h-8 flex items-center justify-center bg-gray-100 rounded border border-gray-200 shrink-0 text-gray-400 text-xs px-3 min-w-[5rem]">Logo</div>
              </div>
            </article>
          </div>
          <!-- Šipky -->
          <button type="button" id="hero-ref-prev" class="absolute left-0 top-1/2 -translate-y-1/2 w-11 h-11 -ml-1 rounded-full bg-white shadow-md border border-gray-200 flex items-center justify-center text-gray-500 hover:shadow-lg transition-all z-10 ref-arrow-hover" aria-label="Předchozí reference">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button type="button" id="hero-ref-next" class="absolute right-0 top-1/2 -translate-y-1/2 w-11 h-11 -mr-1 rounded-full bg-white shadow-md border border-gray-200 flex items-center justify-center text-gray-500 hover:shadow-lg transition-all z-10 ref-arrow-hover" aria-label="Další reference">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
          <!-- Tečky skryté -->
          <div id="hero-ref-dots" class="hidden flex justify-start gap-2.5 mt-5 flex-wrap" aria-hidden="true"></div>
        </div>
        <script is:inline>
          (function(){
            var refs = [
              { quote: 'Během 16 hodin se podařilo změnit můj mindset týkající se AI.', company: 'FESTOOL', desc: 'Výroba nářadí' },
              { quote: 'Radek je boží. :)', company: 'BARENTZ', desc: 'Distribuce surovin' },
              { quote: 'Nejlepší školení ze všech absolvovaných. Lektor skvělý a hodně praktických ukázek.', company: 'České dráhy', desc: 'Ekonomické oddělení' },
              { quote: 'Naprostá spokojenost. Vše bylo srozumitelné, praktické a dobře vysvětlené.', company: 'České dráhy', desc: 'Ekonomické oddělení' },
              { quote: 'Musím říct, že jsem se AI doposud bránil, ale s vaším vysvětlením mi to otevřelo oči.', company: 'INOVAN CZ', desc: 'Výroba komponentů' },
              { quote: 'V Tennecu jsem už 10 let, toto školení řadím do top 3.', company: 'TENNECO CA', desc: 'Automotive' },
              { quote: 'Za mě – takto by mělo školení vypadat. Pane Koulovi VELKÉ DÍKY.', company: 'České dráhy', desc: 'Ekonomické oddělení' }
            ];
            var idx = 0;
            function getEl(id) { return document.getElementById(id); }
            var q1 = getEl('hero-ref-quote-1'), c1 = getEl('hero-ref-company-1'), d1 = getEl('hero-ref-desc-1');
            var q2 = getEl('hero-ref-quote-2'), c2 = getEl('hero-ref-company-2'), d2 = getEl('hero-ref-desc-2');
            var prevBtn = getEl('hero-ref-prev'), nextBtn = getEl('hero-ref-next');
            if (!q1 || !c1 || !d1 || !q2 || !c2 || !d2) return;
            function fillBox(quoteEl, companyEl, descEl, r, animate) {
              if (animate) {
                quoteEl.style.opacity = '0';
                quoteEl.style.transform = 'translateY(8px)';
                companyEl.style.opacity = '0';
                descEl.style.opacity = '0';
              }
              setTimeout(function(){
                quoteEl.textContent = '\u201E' + r.quote + '\u201C';
                companyEl.textContent = r.company;
                descEl.textContent = r.desc;
                if (animate) {
                  quoteEl.style.opacity = '1';
                  quoteEl.style.transform = 'translateY(0)';
                  companyEl.style.opacity = '1';
                  descEl.style.opacity = '1';
                }
              }, animate ? 150 : 0);
            }
            function show(animate) {
              var r1 = refs[idx % refs.length];
              var r2 = refs[(idx + 1) % refs.length];
              fillBox(q1, c1, d1, r1, animate);
              fillBox(q2, c2, d2, r2, animate);
            }
            function goNext() { idx = (idx + 2) % refs.length; show(true); }
            function goPrev() { idx = (idx - 2 + refs.length) % refs.length; show(true); }
            if (prevBtn) prevBtn.addEventListener('click', function() { goPrev(); });
            if (nextBtn) nextBtn.addEventListener('click', function() { goNext(); });
            show(false);
            setInterval(goNext, 4000);
          })();
        </script>

        <!-- Tři karty ve stylu z obrázku -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-4">
          <div id="ref-card-1" class="group rounded-2xl p-6 shadow-md min-h-[180px] transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 ref-small-card relative">
            <p id="ref-card-1-quote" class="text-gray-700 text-sm leading-relaxed mb-5 text-left"></p>
            <div class="h-0.5 w-10 rounded-full ref-small-card-line mb-3"></div>
            <div class="flex items-center justify-between gap-3">
              <div>
                <p id="ref-card-1-company" class="font-semibold text-gray-900 text-sm"></p>
                <p id="ref-card-1-desc" class="text-xs text-gray-600 mt-0.5"></p>
              </div>
              <div id="ref-card-1-logo" class="h-8 flex items-center justify-center bg-gray-100 rounded border border-gray-200 shrink-0 text-gray-400 text-xs px-3 min-w-[5rem]">Logo</div>
            </div>
          </div>
          <div id="ref-card-2" class="group rounded-2xl p-6 shadow-md min-h-[180px] transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 ref-small-card relative">
            <p id="ref-card-2-quote" class="text-gray-700 text-sm leading-relaxed mb-5 text-left"></p>
            <div class="h-0.5 w-10 rounded-full ref-small-card-line mb-3"></div>
            <div class="flex items-center justify-between gap-3">
              <div>
                <p id="ref-card-2-company" class="font-semibold text-gray-900 text-sm"></p>
                <p id="ref-card-2-desc" class="text-xs text-gray-600 mt-0.5"></p>
              </div>
              <div id="ref-card-2-logo" class="h-8 flex items-center justify-center bg-gray-100 rounded border border-gray-200 shrink-0 text-gray-400 text-xs px-3 min-w-[5rem]">Logo</div>
            </div>
          </div>
          <div id="ref-card-3" class="group rounded-2xl p-6 shadow-md min-h-[180px] transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 ref-small-card relative">
            <p id="ref-card-3-quote" class="text-gray-700 text-sm leading-relaxed mb-5 text-left"></p>
            <div class="h-0.5 w-10 rounded-full ref-small-card-line mb-3"></div>
            <div class="flex items-center justify-between gap-3">
              <div>
                <p id="ref-card-3-company" class="font-semibold text-gray-900 text-sm"></p>
                <p id="ref-card-3-desc" class="text-xs text-gray-600 mt-0.5"></p>
              </div>
              <div id="ref-card-3-logo" class="h-8 flex items-center justify-center bg-gray-100 rounded border border-gray-200 shrink-0 text-gray-400 text-xs px-3 min-w-[5rem]">Logo</div>
            </div>
          </div>
        </div>
        <script is:inline>
          (function(){
            var refs = [
              { quote: 'Během 16 hodin se podařilo změnit můj mindset týkající se AI.', company: 'FESTOOL', desc: 'Výroba nářadí' },
              { quote: 'Radek je boží. :)', company: 'BARENTZ', desc: 'Distribuce surovin' },
              { quote: 'Nejlepší školení ze všech absolvovaných. Lektor skvělý a hodně praktických ukázek.', company: 'České dráhy', desc: 'Ekonomické oddělení' },
              { quote: 'Naprostá spokojenost. Vše bylo srozumitelné, praktické a dobře vysvětlené.', company: 'České dráhy', desc: 'Ekonomické oddělení' },
              { quote: 'Musím říct, že jsem se AI doposud bránil, ale s vaším vysvětlením mi to otevřelo oči.', company: 'INOVAN CZ', desc: 'Výroba komponentů' },
              { quote: 'V Tennecu jsem už 10 let, toto školení řadím do top 3.', company: 'TENNECO CA', desc: 'Automotive' },
              { quote: 'Za mě – takto by mělo školení vypadat. Pane Koulovi VELKÉ DÍKY.', company: 'České dráhy', desc: 'Ekonomické oddělení' }
            ];
            var offsets = [0, 2, 4];
            function fillCard(n, ref) {
              var q = document.getElementById('ref-card-' + n + '-quote');
              var c = document.getElementById('ref-card-' + n + '-company');
              var d = document.getElementById('ref-card-' + n + '-desc');
              if (q && c && d) { q.textContent = '\u201E' + ref.quote + '\u201C'; c.textContent = ref.company; d.textContent = ref.desc; }
            }
            function rotateCards() {
              for (var i = 0; i < 3; i++) {
                offsets[i] = (offsets[i] + 1) % refs.length;
                fillCard(i + 1, refs[offsets[i]]);
              }
            }
            for (var j = 0; j < 3; j++) fillCard(j + 1, refs[offsets[j]]);
            setInterval(rotateCards, 5000);
          })();
        </script>

      </div>
